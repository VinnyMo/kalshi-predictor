# Supply credentials locally; never commit .env.
KALSHI_API_KEY_ID=
# PEM contents, not a file path. Use a quoted value with escaped \n newlines.
KALSHI_PRIVATE_KEY=
KALSHI_ENVIRONMENT=demo
# Initial simulated balance in dollars (not an account deposit).
STARTING_BALANCE=100
# Optional, used by price_collector.py only.
COINGECKO_API_KEY=
