# Kalshi API Configuration
# Copy this file to .env and fill in your credentials

# Your API Key ID from https://demo.kalshi.co/ (Account & Security -> API Keys)
KALSHI_API_KEY_ID=your_api_key_id_here

# Your private key (paste the entire key including BEGIN/END lines)
# Replace newlines with \n or use quotes and actual newlines
KALSHI_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----
your_key_content_here
-----END EC PRIVATE KEY-----"

# Environment: 'demo' or 'production' (default: demo)
KALSHI_ENVIRONMENT=demo

# Starting balance for simulation in dollars (default: 100)
STARTING_BALANCE=100

# CoinGecko API Key (free demo tier)
# Get yours at: https://www.coingecko.com/en/api/pricing -> Create Free Account
# Then: Developer Dashboard -> + Add New Key
COINGECKO_API_KEY=your_coingecko_api_key_here
